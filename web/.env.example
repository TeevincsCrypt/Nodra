# ---------------------------------------------------------------------------
# Nodra web
#
# Never put a private key, RPC secret, or API secret in this file. Anything
# prefixed NEXT_PUBLIC_ is bundled into the browser and is world-readable — the
# variables below it are server-only and are never sent to the browser.
# ---------------------------------------------------------------------------

# Optional. Base URL of a verified Creditcoin CC3 Testnet block explorer.
# Left unset by default: no verified explorer URL is recorded in this repository,
# and the UI will not invent one. When unset, Creditcoin hashes render as
# copyable values instead of links.
# NEXT_PUBLIC_CREDITCOIN_EXPLORER_URL="https://<verified-creditcoin-explorer>"

# ---------------------------------------------------------------------------
# Server-only — read at request/build time, never exposed to the browser.
# The dashboard degrades gracefully (falls back to the recorded settlement) if
# either RPC is unset or unreachable; it never crashes.
# ---------------------------------------------------------------------------

# Sepolia RPC used for live reads of NodraDeviceRegistry (any public endpoint).
SOURCE_CHAIN_RPC_URL=""

# Creditcoin CC3 Testnet RPC used for live reads of NodraIncentiveController.
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"

# Optional. Overrides the public contract addresses baked into lib/protocol.ts.
# These are public addresses, not secrets — safe to leave unset, in which case
# the known deployed addresses are used.
# NODRA_DEVICE_REGISTRY_ADDRESS="0xacC1Cd54c174b0F87D26E88132A28f7dC1983CF6"
# NODRA_INCENTIVE_CONTROLLER_ADDRESS="0x0dD97a8C7Dc1F143f682BD5c306BF00efc9396B9"
