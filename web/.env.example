# ---------------------------------------------------------------------------
# Nodra web — PUBLIC configuration only.
#
# Never put a private key, RPC secret, or API secret in this file. Anything
# prefixed NEXT_PUBLIC_ is bundled into the browser and is world-readable.
# ---------------------------------------------------------------------------

# Optional. Base URL of a verified Creditcoin CC3 Testnet block explorer.
# Left unset by default: no verified explorer URL is recorded in this repository,
# and the UI will not invent one. When unset, Creditcoin hashes render as
# copyable values instead of links.
# NEXT_PUBLIC_CREDITCOIN_EXPLORER_URL="https://<verified-creditcoin-explorer>"
