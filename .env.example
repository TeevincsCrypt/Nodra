# ---------------------------------------------------------------------------
# Nodra Phase 2 — Sepolia -> Attestcoin -> Creditcoin CC3 Testnet
# Copy to `.env` and fill in the "User-provided" section.
# ---------------------------------------------------------------------------

## Attestcoin / Creditcoin CC3 Testnet defaults (verified against the official examples)
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"

# Source chain key for Sepolia on CC3 Testnet.
# NOTE: this is NOT the EVM chain id (Sepolia's chain id is 11155111).
SOURCE_CHAIN_KEY=1

# Pre-deployed EvmV1Decoder library on CC3 Testnet. Linked at deploy time.
EVM_V1_DECODER_LIBRARY_ADDRESS="0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B"

## User-provided
# Sepolia RPC (Infura / Alchemy / any public endpoint)
SOURCE_CHAIN_RPC_URL=""

# Funded with Sepolia ETH — deploys NodraDeviceRegistry and reports device activity
SOURCE_CHAIN_WALLET_PRIVATE_KEY=""

# Funded with CC3 Testnet CTC — deploys NodraIncentiveController and submits proofs
CREDITCOIN_WALLET_PRIVATE_KEY=""

## Filled in after deployment
NODRA_DEVICE_REGISTRY_ADDRESS=""
NODRA_INCENTIVE_CONTROLLER_ADDRESS=""
